{
  "manifest_version": "0.2",
  "name": "copy-fail-mcp",
  "version": "0.1.0",
  "description": "CVE-2026-31431 Copy Fail — Linux kernel LPE tester via MCP",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "src/copy_fail_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","copy_fail_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "cf_get_exploit_script", "description": "cf_get_exploit_script" }
  ]
}
